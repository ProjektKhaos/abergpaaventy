# Sakerhetsbaslinje for publik sajt
Options -Indexes

# Blockera Git och andra dolda filer/kataloger, men tillat .well-known.
RedirectMatch 404 "(^|/)\.git(/|$)"
RedirectMatch 404 "(^|/)\.(?!well-known/)"

# Blockera interna projektkataloger.
RedirectMatch 404 "^/(app|sql|storage|mobile-first-web)(/|$)"

# Blockera filtyper som inte ska serveras publikt.
<FilesMatch "\.(md|sql|log|bak|backup|old|orig|save|swp|env|ini|yml|yaml|lock|json)$">
    Require all denied
</FilesMatch>

# Blockera vanliga kansliga projektfiler.
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|README(\.md)?|CHANGELOG(\.md)?|\.env.*)$">
    Require all denied
</FilesMatch>
