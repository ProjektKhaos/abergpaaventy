# uploads/.htaccess – hindrar scriptkorning i uploads-mappen
# Sakerhetskrav: uppladdade filer far aldrig koras som kod.

Options -Indexes

# Stang av PHP dar Apache tillater det.
php_flag engine off

# Blockera scriptliknande filer.
<FilesMatch "\.(php|php[0-9]?|phtml|phar|cgi|pl|py|rb|sh|bash|zsh|exe|dll|jsp|asp|aspx)$">
  Require all denied
</FilesMatch>

# Tillat vanliga bildformat.
<FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg)$">
  Require all granted
</FilesMatch>
