# Åberg På Äventyr - repo ignore

# Local/server-only configuration with database credentials
app/config.php
abergpaaventyr_private/
.env
.env.*
!.env.example

# Runtime uploads: keep the directory protection file, ignore uploaded media
uploads/*
!uploads/.htaccess
!uploads/.gitkeep

# Local/legacy seed scripts may contain site-specific admin data
sql/seed.php
sql/seed_posts.php

# Old archived/generated documentation copies
docs/2/
docs/chillhasse_apan_thailand_design_WITH_MISSION/

# Image folder: ignore bulk photos and duplicate "copy" exports by default
assets/img/*
!assets/img/studera_header.png
!assets/img/poster.jpg
!assets/img/scrapbook.jpg
!assets/img/cm_sign.png
!assets/img/placeholder.svg
!assets/img/studera_fb_og.png

