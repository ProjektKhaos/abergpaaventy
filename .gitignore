*.log
*.tmp
*.bak
*.zip
*.swp
*.swo
.DS_Store
Thumbs.db

# Editor/project-local files
.vscode/
.idea/

# Dependency/build folders if added later
vendor/
node_modules/
dist/
build/
.cache/

# Runtime-cache för interna API-anrop
storage/cache/*
